DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Manual payment destinations (never put passwords, OTPs or gateway secrets here)
JAZZCASH_ACCOUNT_TITLE=MUHAMMAD Shop
